{
  "title": "计算器",
  "kill_on_exit": "CalculatorApp",
  "steps": [
    { "tool": "app_act", "args": { "steps": [ { "action": "click", "aid": "clearButton" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "先把上次留下的值清掉" },
    { "tool": "app_snapshot", "args": { "interactive_only": false, "max_nodes": 14 }, "expect": "显示为 0", "note": "基线：显示为 0" },

    { "tool": "app_act", "args": { "steps": [
      { "action": "click", "aid": "clearButton" },
      { "action": "click", "aid": "num1Button" },
      { "action": "click", "aid": "plusButton" },
      { "action": "click", "aid": "num2Button" },
      { "action": "click", "aid": "equalButton" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "1+2" },
    { "tool": "app_wait", "args": { "name_contains": "显示为 3", "state": "appear", "timeout_ms": 4000 }, "expect": "true", "note": "期望 3" },

    { "tool": "app_act", "args": { "steps": [
      { "action": "click", "aid": "clearButton" },
      { "action": "click", "aid": "num7Button" },
      { "action": "click", "aid": "multiplyButton" },
      { "action": "click", "aid": "num8Button" },
      { "action": "click", "aid": "equalButton" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "7x8" },
    { "tool": "app_wait", "args": { "name_contains": "显示为 56", "state": "appear", "timeout_ms": 4000 }, "expect": "true", "note": "期望 56" },

    { "tool": "app_act", "args": { "steps": [
      { "action": "click", "aid": "clearButton" },
      { "action": "click", "aid": "num1Button" },
      { "action": "click", "aid": "num5Button" },
      { "action": "click", "aid": "minusButton" },
      { "action": "click", "aid": "num5Button" },
      { "action": "click", "aid": "equalButton" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "15-5" },
    { "tool": "app_wait", "args": { "name_contains": "显示为 10", "state": "appear", "timeout_ms": 4000 }, "expect": "true", "note": "期望 10" },

    { "tool": "app_act", "args": { "steps": [
      { "action": "click", "aid": "clearButton" },
      { "action": "click", "aid": "num2Button" },
      { "action": "click", "aid": "multiplyButton" },
      { "action": "click", "aid": "num3Button" },
      { "action": "click", "aid": "multiplyButton" },
      { "action": "click", "aid": "num4Button" },
      { "action": "click", "aid": "equalButton" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "2x3x4" },
    { "tool": "app_wait", "args": { "name_contains": "显示为 24", "state": "appear", "timeout_ms": 4000 }, "expect": "true", "note": "期望 24" },

    { "tool": "app_act", "args": { "steps": [
      { "action": "click", "aid": "clearButton" },
      { "action": "click", "aid": "num8Button" },
      { "action": "click", "aid": "num1Button" },
      { "action": "click", "aid": "squareRootButton" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "sqrt(81)" },
    { "tool": "app_wait", "args": { "name_contains": "显示为 9", "state": "appear", "timeout_ms": 4000 }, "expect": "true", "note": "期望 9" },

    { "tool": "app_act", "args": { "steps": [
      { "action": "click", "aid": "clearButton" },
      { "action": "click", "aid": "num9Button" },
      { "action": "click", "aid": "xpower2Button" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "9^2" },
    { "tool": "app_wait", "args": { "name_contains": "显示为 81", "state": "appear", "timeout_ms": 4000 }, "expect": "true", "note": "期望 81" },

    { "tool": "app_act", "args": { "steps": [
      { "action": "click", "aid": "clearButton" },
      { "action": "click", "aid": "num5Button" },
      { "action": "click", "aid": "invertButton" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "5 的倒数" },
    { "tool": "app_wait", "args": { "name_contains": "显示为 0.2", "state": "appear", "timeout_ms": 4000 }, "expect": "true", "note": "期望 0.2" },

    { "tool": "app_act", "args": { "steps": [
      { "action": "click", "aid": "clearButton" },
      { "action": "click", "aid": "num2Button" },
      { "action": "click", "aid": "num0Button" },
      { "action": "click", "aid": "num0Button" },
      { "action": "click", "aid": "plusButton" },
      { "action": "click", "aid": "num1Button" },
      { "action": "click", "aid": "num0Button" },
      { "action": "click", "aid": "percentButton" },
      { "action": "click", "aid": "equalButton" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "200+10% => 220（百分比要跟前一个操作数配对，单独按 % 会算成 0）" },
    { "tool": "app_wait", "args": { "name_contains": "显示为 220", "state": "appear", "timeout_ms": 4000 }, "expect": "true", "note": "期望 220" },

    { "tool": "app_act", "args": { "steps": [
      { "action": "click", "aid": "clearButton" },
      { "action": "click", "aid": "num1Button" },
      { "action": "click", "aid": "divideButton" },
      { "action": "click", "aid": "num3Button" },
      { "action": "click", "aid": "equalButton" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "1/3" },
    { "tool": "app_wait", "args": { "name_contains": "显示为 0.333333333333", "state": "appear", "timeout_ms": 4000 }, "expect": "true", "note": "期望 0.3333..." },

    { "tool": "app_act", "args": { "steps": [
      { "action": "click", "aid": "clearButton" },
      { "action": "click", "aid": "num0Button" },
      { "action": "click", "aid": "decimalSeparatorButton" },
      { "action": "click", "aid": "num5Button" },
      { "action": "click", "aid": "plusButton" },
      { "action": "click", "aid": "num0Button" },
      { "action": "click", "aid": "decimalSeparatorButton" },
      { "action": "click", "aid": "num5Button" },
      { "action": "click", "aid": "equalButton" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "0.5+0.5" },
    { "tool": "app_wait", "args": { "name_contains": "显示为 1", "state": "appear", "timeout_ms": 4000 }, "expect": "true", "note": "期望 1" },

    { "tool": "app_act", "args": { "steps": [
      { "action": "click", "aid": "clearButton" },
      { "action": "click", "aid": "num6Button" },
      { "action": "click", "aid": "negateButton" },
      { "action": "click", "aid": "multiplyButton" },
      { "action": "click", "aid": "num2Button" },
      { "action": "click", "aid": "equalButton" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "-6x2" },
    { "tool": "app_wait", "args": { "name_contains": "显示为 -12", "state": "appear", "timeout_ms": 4000 }, "expect": "true", "note": "期望 -12" },

    { "tool": "app_act", "args": { "steps": [
      { "action": "click", "aid": "clearButton" },
      { "action": "click", "aid": "num9Button" },
      { "action": "click", "aid": "num9Button" },
      { "action": "click", "aid": "num9Button" },
      { "action": "click", "aid": "plusButton" },
      { "action": "click", "aid": "num1Button" },
      { "action": "click", "aid": "equalButton" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "999+1" },
    { "tool": "app_wait", "args": { "name_contains": "显示为 1,000", "state": "appear", "timeout_ms": 4000 }, "expect": "true", "note": "期望 1,000（千位分隔符是真实显示的一部分）" },

    { "tool": "app_act", "args": { "steps": [
      { "action": "click", "aid": "clearButton" },
      { "action": "click", "aid": "num4Button" },
      { "action": "click", "aid": "num7Button" },
      { "action": "click", "aid": "multiplyButton" },
      { "action": "click", "aid": "num4Button" },
      { "action": "click", "aid": "num7Button" },
      { "action": "click", "aid": "equalButton" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "47x47" },
    { "tool": "app_wait", "args": { "name_contains": "显示为 2,209", "state": "appear", "timeout_ms": 4000 }, "expect": "true", "note": "期望 2,209" },

    { "tool": "app_act", "args": { "steps": [
      { "action": "click", "aid": "clearEntryButton" },
      { "action": "click", "aid": "num7Button" },
      { "action": "click", "aid": "backSpaceButton" } ] }, "expect": "# steps ok=", "reject": "\"ok\":false", "note": "清除条目 + 7 + Backspace" },
    { "tool": "app_wait", "args": { "name_contains": "显示为 0", "state": "appear", "timeout_ms": 4000 }, "expect": "true", "note": "期望回到 0" },

    { "tool": "app_act", "args": { "id": "e999", "action": "click" }, "expect_error": true, "note": "反向：陈旧 id 必须报错" },

    { "tool": "app_act", "args": { "aid": "noSuchButton", "action": "click" }, "expect_error": true, "note": "反向：不存在的 aid 必须报错" },

    { "tool": "app_window", "args": { "action": "list", "title_contains": "计算器" }, "expect": ["ApplicationFrameWindow", "\"visible\":true"], "note": "窗口枚举仍能看到它（注意：中文在 JSON 里被转成 \\uXXXX）" }
  ]
}
